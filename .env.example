# --- General ---
ENVIRONMENT=development
LOG_LEVEL=INFO

# --- Ports (host-side; change if these collide with something local) ---
API_PORT=8000
WEB_PORT=3000
POSTGRES_PORT=5432

# --- Postgres ---
# localhost is correct for host-side tools (make incident, make test, ...)
# reading this file directly. Inside Docker Compose, the api service talks
# to Postgres over the compose network and ignores this value (it hardcodes
# POSTGRES_HOST=postgres in docker-compose.yml).
POSTGRES_HOST=localhost
POSTGRES_USER=incidentlab
POSTGRES_PASSWORD=incidentlab
POSTGRES_DB=incidentlab

# --- Frontend ---
# Read live, per request, by apps/web/app/api/config/route.ts, which
# hands it to the browser at runtime — deliberately NOT a NEXT_PUBLIC_-
# prefixed var, since Next.js inlines those into the browser bundle at
# `docker build` time, before a deployment host like Render has even
# created this container. See docs/design-decisions.md.
API_URL=http://localhost:8000

# --- CORS (Phase 9) ---
# Comma-separated origins the API will accept browser requests from.
# http://localhost:3000 (this file's default) only works for local dev —
# a real deployment MUST set this to the actual origin the web app is
# served from (e.g. https://incidentlab.example.com), or the browser will
# block every request the frontend makes. See docs/deployment.md.
CORS_ALLOWED_ORIGINS=http://localhost:3000

# --- LLM (used by `make investigate`; agents work without one — see
# docs/design-decisions.md DDR-010) ---
# LLM_PROVIDER: ollama (default) | openai | anthropic (the latter two mean
# any OpenAI/Anthropic-*compatible* HTTP API, via LLM_BASE_URL — not a
# vendor lock-in). For ollama: install Ollama natively (not dockerized —
# most Ollama setups are native for GPU access) and `ollama pull` a model.
LLM_PROVIDER=ollama
LLM_MODEL=llama3.1
LLM_BASE_URL=http://localhost:11434
LLM_API_KEY=
LLM_TIMEOUT_SECONDS=30.0

# --- Confidence gate (spec's own words: "initial configuration, not
# universal truths") ---
CONFIDENCE_STRONG_THRESHOLD=0.90
CONFIDENCE_REVIEW_THRESHOLD=0.70

# --- Tool/investigation limits (Phase 8 — see docs/design-decisions.md
# DDR-023) ---
TOOL_TIMEOUT_SECONDS=10.0
MAX_TOOL_CALLS_PER_INVESTIGATION=100
INVESTIGATION_TIMEOUT_SECONDS=120.0
