# --- General ---
ENVIRONMENT=development
LOG_LEVEL=INFO

# --- Ports (host-side; change if these collide with something local) ---
API_PORT=8000
WEB_PORT=3000
POSTGRES_PORT=5432

# --- Postgres ---
# localhost is correct for host-side tools (make incident, make test, ...)
# reading this file directly. Inside Docker Compose, the api service talks
# to Postgres over the compose network and ignores this value (it hardcodes
# POSTGRES_HOST=postgres in docker-compose.yml).
POSTGRES_HOST=localhost
POSTGRES_USER=incidentlab
POSTGRES_PASSWORD=incidentlab
POSTGRES_DB=incidentlab

# --- Frontend ---
NEXT_PUBLIC_API_URL=http://localhost:8000

# --- LLM (used by `make investigate`; agents work without one — see
# docs/design-decisions.md DDR-010) ---
# LLM_PROVIDER: ollama (default) | openai | anthropic (the latter two mean
# any OpenAI/Anthropic-*compatible* HTTP API, via LLM_BASE_URL — not a
# vendor lock-in). For ollama: install Ollama natively (not dockerized —
# most Ollama setups are native for GPU access) and `ollama pull` a model.
LLM_PROVIDER=ollama
LLM_MODEL=llama3.1
LLM_BASE_URL=http://localhost:11434
LLM_API_KEY=
LLM_TIMEOUT_SECONDS=30.0

# --- Confidence gate (spec's own words: "initial configuration, not
# universal truths") ---
CONFIDENCE_STRONG_THRESHOLD=0.90
CONFIDENCE_REVIEW_THRESHOLD=0.70
